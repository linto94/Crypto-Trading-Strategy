// This Pine Script™ code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// © Linto Market Wizard
//
// Linto Key Zones (LKZ) v1.0
// Maps clustered pivot support/resistance zones from the 1H and 15M timeframes.
// It only answers "where are the key zones?". No signals, entries, stops or targets.
//
// How it works (per layer, 1H and 15M, calculated separately):
//   1. Pivots: ta.pivothigh / ta.pivotlow with N bars each side (1H = 5, 15M = 10).
//   2. Cluster: newest unused pivot seeds a group; other pivots join while the group's
//      total width stays within the max width (1H: x ATR(24) 1H, 15M: x ATR(96) 15M).
//      Overlapping groups: the one with more pivots wins.
//   3. Qualify: at least 3 pivots. Box = lowest to highest pivot in the cluster.
//   4. Broken: after the zone's newest pivot, a candle closed above it AND a candle
//      closed below it (price went through). Broken zones are hidden. A new pivot in
//      the zone rebuilds it.
//   Display: 1H zones = plain light fill (no border); 15M zones = dashed outline. Zones stop
//   a set number of candles right of price. On 1M-5M charts zones are shorter and lighter
//   (thin outline, or an edge line only).
//   5. Select: nearest 2 above + 2 below price in total. 15M zones that overlap a
//      1H zone are dropped (1H has priority).
// Non-repainting: all timeframe data is taken from closed bars only
// (request.security with [1] + lookahead_on).
//
// Display by chart timeframe:
//   below 15M (1M-5M) : 1H zones, plus 15M zones if "Show 15M zones" is ON
//   15M               : 15M zones only
//   30M / 1H          : 1H zones only
//   above 1H          : nothing

//@version=6
indicator("Linto Key Zones", shorttitle = "LKZ", overlay = true, max_boxes_count = 50, max_labels_count = 50, max_lines_count = 50, max_bars_back = 1000)

//=============================================================================
// INPUTS
//=============================================================================
gL = "Layers"
show15 = input.bool(false, "Show 15M zones on execution charts (below 15M)", group = gL, tooltip = "Only affects 1M-5M charts. The 15M chart always shows 15M zones; the 1H chart always shows 1H zones.")

gZ = "Zone rules"
len1H   = input.int(5, "1H pivot length (bars each side)", minval = 2, maxval = 20, group = gZ)
len15   = input.int(10, "15M pivot length (bars each side)", minval = 2, maxval = 30, group = gZ)
mult1H  = input.float(0.5, "1H max zone width (x 1H ATR 24)", minval = 0.1, maxval = 3.0, step = 0.05, group = gZ, tooltip = "Target: about one typical 15M candle. Check the calibration line and adjust per instrument if needed.")
mult15  = input.float(1.0, "15M max zone width (x 15M ATR 96)", minval = 0.1, maxval = 3.0, step = 0.05, group = gZ, tooltip = "1.0 = one typical 15M candle (24-hour average).")
minPiv  = input.int(3, "Minimum pivots per zone", minval = 2, maxval = 10, group = gZ)
maxPiv  = input.int(40, "Pivot history per layer", minval = 10, maxval = 100, group = gZ)
perSide = input.int(2, "Zones per side (above / below)", minval = 1, maxval = 4, group = gZ)
srcMode = input.string("High/Low", "Pivot source", options = ["High/Low", "Close/Open"], group = gZ)

gD = "Display"
showPD  = input.bool(true, "PDH/PDL tag on labels (info only)", group = gD)
showCal = input.bool(false, "Show calibration info", group = gD, tooltip = "Bottom-right text that checks zone widths. Not needed for trading.")
colRes  = input.color(#f23645, "Zone above price", group = gD)
colSup  = input.color(#089981, "Zone below price", group = gD)
lblBars = input.int(20, "Zone length right of price (bars)", minval = 5, maxval = 100, group = gD, tooltip = "Zones stop this many candles to the right of the current candle; the label sits at the end.")
exStyle = input.string("Light outline", "Zone style on 1M-5M charts", options = ["Light outline", "Edge line only"], group = gD, tooltip = "Light outline = thin border with a faint fill. Edge line only = one line at the zone edge facing price.")
exBack  = input.int(120, "Zone length left on 1M-5M charts (bars)", minval = 10, maxval = 1000, group = gD, tooltip = "On 1M-5M charts zones start this many candles back instead of at the oldest pivot. 120 = two hours on the 1M chart.")
exNear  = input.float(2.0, "On 1M-5M, show zones within (x 1H ATR)", minval = 0.5, maxval = 20, step = 0.5, group = gD, tooltip = "Zones further from price than this are not drawn on 1M-5M charts, so they cannot squash the chart. They still show on 1H/15M. Tip: also right-click the price scale > Scale price chart only.")

gA = "Alert"
useAlert = input.bool(true, "Alert when price enters a zone", group = gA, tooltip = "Create one alert on this indicator with 'Any alert() function call'.")

const int PRE = 4   // nearest zones per side passed out of each layer
bool useBody = srcMode == "Close/Open"

//=============================================================================
// HELPERS
//=============================================================================
f_get(array<float> a, int i) =>
    i < array.size(a) ? array.get(a, i) : na

f_add(array<float> T, array<float> B, array<float> C, array<float> S, array<int> L, float t, float b, float c, float s, int lay) =>
    if not na(t)
        array.push(T, t)
        array.push(B, b)
        array.push(C, c)
        array.push(S, s)
        array.push(L, lay)
    true

//=============================================================================
// ZONE ENGINE - runs inside the 1H or 15M data request
//=============================================================================
f_zones(simple int len, simple float mult, simple int atrLen, simple int off) =>
    float sH  = useBody ? math.max(open, close) : high
    float sL  = useBody ? math.min(open, close) : low
    float ph  = ta.pivothigh(sH, len, len)
    float pl  = ta.pivotlow(sL, len, len)
    float atr = ta.atr(atrLen)

    // --- pivot history (newest first) ---
    var array<float> pPrice = array.new<float>()
    var array<int>   pTime  = array.new<int>()
    var array<int>   pBar   = array.new<int>()
    bool newPiv = false
    if not na(ph)
        array.unshift(pPrice, ph)
        array.unshift(pTime, time[len])
        array.unshift(pBar, bar_index - len)
        newPiv := true
    if not na(pl)
        array.unshift(pPrice, pl)
        array.unshift(pTime, time[len])
        array.unshift(pBar, bar_index - len)
        newPiv := true
    while array.size(pPrice) > maxPiv
        array.pop(pPrice)
        array.pop(pTime)
        array.pop(pBar)

    // --- zones ---
    var array<float> zTop   = array.new<float>()
    var array<float> zBot   = array.new<float>()
    var array<int>   zCnt   = array.new<int>()
    var array<int>   zStart = array.new<int>()
    var array<bool>  zAbove = array.new<bool>()   // a close above the zone since its newest pivot
    var array<bool>  zBelow = array.new<bool>()   // a close below the zone since its newest pivot

    if newPiv and not na(atr)
        array.clear(zTop)
        array.clear(zBot)
        array.clear(zCnt)
        array.clear(zStart)
        array.clear(zAbove)
        array.clear(zBelow)
        float width = mult * atr
        int n = array.size(pPrice)
        if n >= minPiv
            array<bool>  used   = array.new<bool>(n, false)
            array<float> cTop   = array.new<float>()
            array<float> cBot   = array.new<float>()
            array<int>   cCnt   = array.new<int>()
            array<int>   cStart = array.new<int>()
            array<int>   cNew   = array.new<int>()
            // clustering pass (same method as Linto-Apex)
            for i = 0 to n - 1
                if not array.get(used, i)
                    float hi  = array.get(pPrice, i)
                    float lo  = hi
                    int   cnt = 1
                    int   oldest = array.get(pTime, i)
                    int   newest = array.get(pBar, i)
                    array.set(used, i, true)
                    for j = 0 to n - 1
                        if j != i and not array.get(used, j)
                            float v   = array.get(pPrice, j)
                            float nHi = math.max(hi, v)
                            float nLo = math.min(lo, v)
                            if nHi - nLo <= width
                                hi  := nHi
                                lo  := nLo
                                cnt += 1
                                oldest := math.min(oldest, array.get(pTime, j))
                                newest := math.max(newest, array.get(pBar, j))
                                array.set(used, j, true)
                    if cnt >= minPiv
                        float mid = (hi + lo) / 2.0
                        int ov = -1
                        int cs = array.size(cTop)
                        if cs > 0
                            for k = 0 to cs - 1
                                if math.abs(mid - (array.get(cTop, k) + array.get(cBot, k)) / 2.0) <= width
                                    ov := k
                                    break
                        if ov >= 0
                            if cnt > array.get(cCnt, ov)
                                array.set(cTop, ov, hi)
                                array.set(cBot, ov, lo)
                                array.set(cCnt, ov, cnt)
                                array.set(cStart, ov, oldest)
                                array.set(cNew, ov, newest)
                        else
                            array.push(cTop, hi)
                            array.push(cBot, lo)
                            array.push(cCnt, cnt)
                            array.push(cStart, oldest)
                            array.push(cNew, newest)
            // store zones: minimum visible thickness + broken flags since newest pivot
            int m = array.size(cTop)
            if m > 0
                for k = 0 to m - 1
                    float t = array.get(cTop, k)
                    float b = array.get(cBot, k)
                    float minT = 0.1 * atr
                    if t - b < minT
                        float md = (t + b) / 2.0
                        t := md + minT / 2.0
                        b := md - minT / 2.0
                    bool ab = false
                    bool be = false
                    int lb = math.min(bar_index - array.get(cNew, k), 999)
                    for q = 0 to lb
                        if close[q] > t
                            ab := true
                        if close[q] < b
                            be := true
                    array.push(zTop, t)
                    array.push(zBot, b)
                    array.push(zCnt, array.get(cCnt, k))
                    array.push(zStart, array.get(cStart, k))
                    array.push(zAbove, ab)
                    array.push(zBelow, be)
    else
        int zs = array.size(zTop)
        if zs > 0
            for k = 0 to zs - 1
                if close > array.get(zTop, k)
                    array.set(zAbove, k, true)
                if close < array.get(zBot, k)
                    array.set(zBelow, k, true)

    // --- pass out the nearest PRE unbroken zones on each side of this timeframe's close ---
    array<float> oT = array.new<float>()
    array<float> oB = array.new<float>()
    array<float> oC = array.new<float>()
    array<float> oS = array.new<float>()
    int zn = array.size(zTop)
    array<bool> taken = array.new<bool>(zn, false)
    for side = 0 to 1
        for r = 1 to PRE
            int   best  = -1
            float bestD = 1e20
            if zn > 0
                for k = 0 to zn - 1
                    bool broken = array.get(zAbove, k) and array.get(zBelow, k)
                    if not broken and not array.get(taken, k)
                        float t = array.get(zTop, k)
                        float b = array.get(zBot, k)
                        bool isAbove = (t + b) / 2.0 >= close
                        if (side == 0) == isAbove
                            float d = isAbove ? math.max(b - close, 0.0) : math.max(close - t, 0.0)
                            if d < bestD
                                bestD := d
                                best  := k
            if best >= 0
                array.set(taken, best, true)
                array.push(oT, array.get(zTop, best))
                array.push(oB, array.get(zBot, best))
                array.push(oC, array.get(zCnt, best))
                array.push(oS, array.get(zStart, best))

    float t0 = f_get(oT, 0)
    float b0 = f_get(oB, 0)
    float c0 = f_get(oC, 0)
    float s0 = f_get(oS, 0)
    float t1 = f_get(oT, 1)
    float b1 = f_get(oB, 1)
    float c1 = f_get(oC, 1)
    float s1 = f_get(oS, 1)
    float t2 = f_get(oT, 2)
    float b2 = f_get(oB, 2)
    float c2 = f_get(oC, 2)
    float s2 = f_get(oS, 2)
    float t3 = f_get(oT, 3)
    float b3 = f_get(oB, 3)
    float c3 = f_get(oC, 3)
    float s3 = f_get(oS, 3)
    float t4 = f_get(oT, 4)
    float b4 = f_get(oB, 4)
    float c4 = f_get(oC, 4)
    float s4 = f_get(oS, 4)
    float t5 = f_get(oT, 5)
    float b5 = f_get(oB, 5)
    float c5 = f_get(oC, 5)
    float s5 = f_get(oS, 5)
    float t6 = f_get(oT, 6)
    float b6 = f_get(oB, 6)
    float c6 = f_get(oC, 6)
    float s6 = f_get(oS, 6)
    float t7 = f_get(oT, 7)
    float b7 = f_get(oB, 7)
    float c7 = f_get(oC, 7)
    float s7 = f_get(oS, 7)
    float nP = array.size(pPrice)
    [t0[off], b0[off], c0[off], s0[off], t1[off], b1[off], c1[off], s1[off], t2[off], b2[off], c2[off], s2[off], t3[off], b3[off], c3[off], s3[off], t4[off], b4[off], c4[off], s4[off], t5[off], b5[off], c5[off], s5[off], t6[off], b6[off], c6[off], s6[off], t7[off], b7[off], c7[off], s7[off], atr[off], nP[off]]

//=============================================================================
// DATA (closed bars only)
//=============================================================================
[ht0, hb0, hc0, hs0, ht1, hb1, hc1, hs1, ht2, hb2, hc2, hs2, ht3, hb3, hc3, hs3, ht4, hb4, hc4, hs4, ht5, hb5, hc5, hs5, ht6, hb6, hc6, hs6, ht7, hb7, hc7, hs7, hAtr, hN] = request.security(syminfo.tickerid, "60", f_zones(len1H, mult1H, 24, 1), lookahead = barmerge.lookahead_on)
[mt0, mb0, mc0, ms0, mt1, mb1, mc1, ms1, mt2, mb2, mc2, ms2, mt3, mb3, mc3, ms3, mt4, mb4, mc4, ms4, mt5, mb5, mc5, ms5, mt6, mb6, mc6, ms6, mt7, mb7, mc7, ms7, mAtr, mN] = request.security(syminfo.tickerid, "15", f_zones(len15, mult15, 96, 1), lookahead = barmerge.lookahead_on)
[pdh, pdl] = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead = barmerge.lookahead_on)

//=============================================================================
// WHAT THIS CHART SHOWS
//=============================================================================
int  tfSec    = timeframe.in_seconds()
bool modeExec = tfSec < 900
bool mode15   = tfSec == 900
bool mode1H   = tfSec > 900 and tfSec <= 3600
bool use1H    = modeExec or mode1H
bool use15    = mode15 or (modeExec and show15)

//=============================================================================
// SELECT + DRAW (last bar only)
//=============================================================================
var array<box>   boxes  = array.new<box>()
var array<label> labels = array.new<label>()
var array<line>  lines  = array.new<line>()
var table status = table.new(position.bottom_right, 1, 4)

if barstate.islast
    while array.size(boxes) > 0
        box.delete(array.pop(boxes))
    while array.size(lines) > 0
        line.delete(array.pop(lines))
    while array.size(labels) > 0
        label.delete(array.pop(labels))

    array<float> cT = array.new<float>()
    array<float> cB = array.new<float>()
    array<float> cC = array.new<float>()
    array<float> cS = array.new<float>()
    array<int>   cL = array.new<int>()
    if use1H
        f_add(cT, cB, cC, cS, cL, ht0, hb0, hc0, hs0, 60)
        f_add(cT, cB, cC, cS, cL, ht1, hb1, hc1, hs1, 60)
        f_add(cT, cB, cC, cS, cL, ht2, hb2, hc2, hs2, 60)
        f_add(cT, cB, cC, cS, cL, ht3, hb3, hc3, hs3, 60)
        f_add(cT, cB, cC, cS, cL, ht4, hb4, hc4, hs4, 60)
        f_add(cT, cB, cC, cS, cL, ht5, hb5, hc5, hs5, 60)
        f_add(cT, cB, cC, cS, cL, ht6, hb6, hc6, hs6, 60)
        f_add(cT, cB, cC, cS, cL, ht7, hb7, hc7, hs7, 60)
    if use15
        f_add(cT, cB, cC, cS, cL, mt0, mb0, mc0, ms0, 15)
        f_add(cT, cB, cC, cS, cL, mt1, mb1, mc1, ms1, 15)
        f_add(cT, cB, cC, cS, cL, mt2, mb2, mc2, ms2, 15)
        f_add(cT, cB, cC, cS, cL, mt3, mb3, mc3, ms3, 15)
        f_add(cT, cB, cC, cS, cL, mt4, mb4, mc4, ms4, 15)
        f_add(cT, cB, cC, cS, cL, mt5, mb5, mc5, ms5, 15)
        f_add(cT, cB, cC, cS, cL, mt6, mb6, mc6, ms6, 15)
        f_add(cT, cB, cC, cS, cL, mt7, mb7, mc7, ms7, 15)

    // 1H priority: drop 15M zones that overlap a 1H zone
    int nC = array.size(cT)
    array<bool> skip = array.new<bool>(nC, false)
    if nC > 0
        for i = 0 to nC - 1
            if array.get(cL, i) == 15
                for j = 0 to nC - 1
                    if array.get(cL, j) == 60 and array.get(cB, i) <= array.get(cT, j) and array.get(cT, i) >= array.get(cB, j)
                        array.set(skip, i, true)

    // nearest zones per side, in total across both layers
    array<int> sel = array.new<int>()
    for side = 0 to 1
        for r = 1 to perSide
            int   best  = -1
            float bestD = 1e20
            float bestC = 0.0
            if nC > 0
                for k = 0 to nC - 1
                    if not array.get(skip, k) and not array.includes(sel, k)
                        float t = array.get(cT, k)
                        float b = array.get(cB, k)
                        bool isAbove = (t + b) / 2.0 >= close
                        if (side == 0) == isAbove
                            float d = isAbove ? math.max(b - close, 0.0) : math.max(close - t, 0.0)
                            float c = array.get(cC, k)
                            if d < bestD or (d == bestD and c > bestC)
                                bestD := d
                                bestC := c
                                best  := k
            if best >= 0
                array.push(sel, best)

    string entered = ""
    int ns = array.size(sel)
    if ns > 0
        for i = 0 to ns - 1
            int   k    = array.get(sel, i)
            float t    = array.get(cT, k)
            float b    = array.get(cB, k)
            bool  is1H = array.get(cL, k) == 60
            bool  isAbove = (t + b) / 2.0 >= close
            color col  = isAbove ? colRes : colSup
            int   xEnd   = time + lblBars * tfSec * 1000
            int   xStart = int(array.get(cS, k))
            float yLbl   = (t + b) / 2.0
            float dist = isAbove ? math.max(b - close, 0.0) : math.max(close - t, 0.0)
            // 1M-5M: only draw zones within reach, so far zones cannot squash the chart
            string tf  = is1H ? "1H" : "15M"
            bool drawIt = not modeExec or na(hAtr) or dist <= exNear * hAtr
            if drawIt
                if not modeExec
                    // 1H/15M charts: 1H = plain light fill, no border. 15M = dashed outline, no fill.
                    array.push(boxes, box.new(xStart, t, xEnd, b, xloc = xloc.bar_time, extend = extend.none,
                         border_color = is1H ? color.new(col, 100) : col, border_width = 1,
                         border_style = is1H ? line.style_solid : line.style_dashed,
                         bgcolor = is1H ? color.new(col, 78) : color.new(col, 100)))
                else
                    // 1M-5M charts: shorter on the left, and lighter so candles stay readable
                    xStart := math.max(xStart, time - exBack * tfSec * 1000)
                    if exStyle == "Light outline"
                        array.push(boxes, box.new(xStart, t, xEnd, b, xloc = xloc.bar_time, extend = extend.none,
                             border_color = color.new(col, 30), border_width = 1,
                             border_style = is1H ? line.style_solid : line.style_dashed,
                             bgcolor = color.new(col, is1H ? 92 : 100)))
                    else
                        float edge = isAbove ? b : t   // the side price meets first
                        yLbl := edge
                        array.push(lines, line.new(xStart, edge, xEnd, edge, xloc = xloc.bar_time, extend = extend.none,
                             color = col, width = is1H ? 2 : 1, style = is1H ? line.style_solid : line.style_dashed))
                string txt = tf + " ×" + str.tostring(array.get(cC, k), "#")
                if showPD
                    if not na(pdh) and pdh <= t and pdh >= b
                        txt += " · PDH"
                    if not na(pdl) and pdl <= t and pdl >= b
                        txt += " · PDL"
                array.push(labels, label.new(xEnd, yLbl, txt, xloc = xloc.bar_time,
                     style = label.style_label_left, color = color.new(color.black, 100), textcolor = col,
                     size = is1H ? size.small : size.tiny))
            // zone entry: this bar touches the zone, the previous bar was fully outside it
            if high >= b and low <= t and (high[1] < b or low[1] > t)
                entered += (entered == "" ? "" : ", ") + tf + " zone " + str.tostring(b, format.mintick) + "-" + str.tostring(t, format.mintick)

    if useAlert and entered != ""
        alert(syminfo.ticker + " entered " + entered, alert.freq_once_per_bar)

    // status lines (information only)
    table.clear(status, 0, 0, 0, 3)
    int row = 0
    if not (use1H or use15)
        table.cell(status, 0, row, "LKZ: zones show on 1H charts and below", text_color = color.gray, text_size = size.small)
        row += 1
    if use1H and hN < 15
        table.cell(status, 0, row, "1H history thin: " + str.tostring(hN, "#") + " pivots", text_color = color.gray, text_size = size.small)
        row += 1
    if use15 and mN < 15
        table.cell(status, 0, row, "15M history thin: " + str.tostring(mN, "#") + " pivots", text_color = color.gray, text_size = size.small)
        row += 1
    if showCal and tfSec <= 900 and hAtr > 0 and mAtr > 0
        float ratio = hAtr / mAtr
        table.cell(status, 0, row, "1H/15M ATR ratio " + str.tostring(ratio, "#.##") + " → 1H width = " + str.tostring(mult1H * ratio, "#.##") + " × 15M candle", text_color = color.gray, text_size = size.small)
